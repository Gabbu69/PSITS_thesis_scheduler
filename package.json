{
  "name": "thesis-defense-scheduler",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/next.mjs dev --webpack",
    "build": "node scripts/next.mjs build --webpack",
    "start": "node scripts/next.mjs start",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:class-schedules": "node scripts/test-class-timetables.mjs",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "node --env-file=.env --import tsx prisma/seed.ts",
    "db:test-fixtures": "node --env-file=.env --import tsx tests/fixtures/seed.ts",
    "db:local": "node scripts/local-postgres.mjs",
    "verify": "node --env-file=.env --import tsx scripts/verify-workflow.ts"
  },
  "dependencies": {
    "next": "16.4.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "@prisma/client": "^6.19.0",
    "better-auth": "^1.3.0",
    "zod": "^4.1.0",
    "@react-pdf/renderer": "^4.3.0",
    "lucide-react": "^0.468.0",
    "next-themes": "^0.4.6",
    "date-fns": "^4.1.0",
    "date-fns-tz": "^3.2.0",
    "react-qr-code": "^2.2.0",
    "@better-auth/utils": "0.5.0"
  },
  "overrides": {
    "deepmerge-ts": "8.0.0"
  },
  "devDependencies": {
    "prisma": "^6.19.0",
    "typescript": "^5.9.0",
    "tsx": "^4.20.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "tailwindcss": "^4.1.0",
    "@tailwindcss/postcss": "^4.1.0",
    "embedded-postgres": "^18.0.0-beta.15"
  }
}
